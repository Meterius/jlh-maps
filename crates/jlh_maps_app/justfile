build-dev:
    just build false false both

build-release:
    just build true false both

build release="false" profile="false" threaded="both":
    just _build-threaded-{{threaded}} "{{release}}" "{{profile}}"

build-dev-watch:
    cargo watch --why -s "just build"

build-dev-watch-threaded:
    cargo watch --why -s "just build false false true"

adjust-threaded-package:
    node -e "const fs = require('node:fs'); const path = 'pkg_threaded/package.json'; const pkg = JSON.parse(fs.readFileSync(path, 'utf8')); pkg.name = 'jlh_maps_app_threaded'; fs.writeFileSync(path, JSON.stringify(pkg, null, 2) + '\n');"

[private]
_build-threaded-both release profile:
    just _build-threaded-false "{{release}}" "{{profile}}"
    just _build-threaded-true "{{release}}" "{{profile}}"

[private]
_build-threaded-false release profile:
    wasm-pack build {{ if release == "true" { "--release" } else { "--dev" } }} --target web --out-dir pkg -- --target wasm32-unknown-unknown {{ if profile == "true" { "--features profile" } else { "" } }}

[private]
[env("RUSTFLAGS", "-C target-feature=+atomics,+bulk-memory -C link-arg=--shared-memory -C link-arg=--max-memory=1073741824 -C link-arg=--import-memory -C link-arg=--export=__wasm_init_tls -C link-arg=--export=__tls_size -C link-arg=--export=__tls_align -C link-arg=--export=__tls_base")]
_build-threaded-true release profile:
    wasm-pack build {{ if release == "true" { "--release" } else { "--dev" } }} --target web --out-dir pkg_threaded -- --target wasm32-unknown-unknown -Z build-std=panic_abort,std --features {{ if profile == "true" { "wasm-threads,profile" } else { "wasm-threads" } }}
    just adjust-threaded-package

bench-edge-distance:
    cargo test -p jlh_maps_app --release --test edge_distance_bench -- --ignored --nocapture

profile-build-edge-distance:
    cargo build -p jlh_maps_frontend --release --bin edge_distance_profile

profile-run-edge-distance: profile-build-edge-distance
    ..\..\target\release\edge_distance_profile.exe

profile-vtune-edge-distance: profile-build-edge-distance
    if exist vtune-results\edge-distance rmdir /s /q vtune-results\edge-distance
    vtune -collect hotspots -result-dir vtune-results\edge-distance -- ..\..\target\release\edge_distance_profile.exe

clean:
    cargo clean -p jlh_maps_app
    if exist pkg rmdir /s /q pkg
    if exist pkg_threaded rmdir /s /q pkg_threaded
